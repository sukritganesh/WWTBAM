{
  "name": "one-million",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An offline-first, millionaire-style trivia game.",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "npm run build:content && vite",
    "build": "npm run build:content && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'e2e/**'",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "validate:content": "tsx scripts/content/validate-content.ts",
    "normalize:content": "tsx scripts/content/normalize-content.ts",
    "build:content": "tsx scripts/content/build-catalog.ts",
    "validate": "npm run typecheck && npm run validate:content && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/sora": "5.1.1",
    "@fontsource/rajdhani": "5.1.1",
    "idb": "8.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "fake-indexeddb": "6.0.0",
    "jsdom": "25.0.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
  }
}
